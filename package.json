{
	"name": "defillama",
	"version": "1.0.0",
	"private": true,
	"homepage": "https://defillama.com",
	"license": "GPL-3.0-or-later",
	"sideEffects": false,
	"scripts": {
		"analyze": "next experimental-analyze",
		"build": "bun run --bun ./scripts/command/runPreparedNext.mjs production build",
		"build:deploy": "bun ./scripts/command/deployBuildCli.ts",
		"build:metadata": "bun ./scripts/command/prepareCli.ts",
		"build:next": "next build",
		"dev": "bun run --bun next dev",
		"dev:prepared": "node ./scripts/command/runPreparedNext.mjs development dev",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"check": "bun run format:check && bun run typecheck && bun run test:typecheck && bun scripts/policies/check-design-tokens.mjs && bun scripts/policies/check-focus-handoff.ts",
		"compiler:baseline": "bun scripts/compilerBaseline.ts",
		"compiler:baseline:check": "bun scripts/compilerBaseline.ts --check",
		"prepare": "git config core.hooksPath .githooks || true",
		"start": "next start",
		"start:docker": "sh ./scripts/docker-entrypoint.sh .next/standalone/server.js",
		"test": "vitest run",
		"test:typecheck": "tsgo -p tsconfig.vitest.json --noEmit",
		"typecheck": "tsgo --noEmit",
		"verify:dataset-snapshot-boundaries": "bun scripts/verifyDatasetSnapshotBoundaries.ts"
	},
	"dependencies": {
