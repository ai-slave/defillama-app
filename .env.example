# Production / deploy reference for Coolify and other hosted environments.
# Do not copy this file to .env.local — use .env.local.example for local development.
#
# One codebase, four deployment profiles:
#   main        defillama.com
#   investors   investors.defillama.com
#   staging     investors preview (same stack as investors; preview flag enabled)
#   enterprise  enterprise.defillama.com
#
# Investor profiles (investors, staging, enterprise) share the same env block below.
# Only these two vars pick the view:
#   NEXT_PUBLIC_INVESTORS_SITE=investors     # investors prod + staging
#   NEXT_PUBLIC_INVESTORS_SITE=enterprise    # enterprise prod
#   NEXT_PUBLIC_INVESTORS_PREVIEW=true       # staging only (uncomment / set on staging deploy)

# =============================================================================
# SHARED — all self-hosted Coolify deployments
# =============================================================================

API_KEY=
CG_KEY=
LLAMA_DB_URL=
NEXT_PUBLIC_SEARCH_API_TOKEN=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
CORS_ALLOWED_ORIGINS=

REDIS_URL=

BUILD_DEPLOYMENT_NAME=
BUILD_NOTIFY_USERS=
BUILD_STATUS_WEBHOOK=
LOGGER_API_KEY=
LOGGER_API_URL=

NEXT_TELEMETRY_DISABLED=1
# Self-hosted builds only. Do not set on Vercel — the build wrapper scopes heap for next build.
NODE_OPTIONS=--max_old_space_size=8192

ROUND_UP_BOT_TOKEN=
TASTY_API_KEY=
TASTY_API_URL=

# =============================================================================
# MAIN PRODUCTION ONLY (defillama.com)
# Add these on top of SHARED. Do not set NEXT_PUBLIC_INVESTORS_* on main.
# =============================================================================

ROBOTS_ALLOW_INDEXING=true

OPS_TELEMETRY_URL=
OPS_TELEMETRY_TOKEN=
OPS_TELEMETRY_TARGET_ID=

# Forgd upstream access and the server-only bearer token accepted by
# GET /api/private/utr/leaderboard. Use different secrets for these two roles.
API_KEY_FORGD=
UTR_LEADERBOARD_API_KEY=
# Claim CAPTCHA: the client widget is enabled when the public site key is set;
# server verification is enabled when the secret key is set.
NEXT_PUBLIC_CLAIMS_TURNSTILE_SITE_KEY=
CLAIMS_TURNSTILE_SECRET_KEY=
UTR_DISCORD_WEBHOOK_URL=
# Best-effort UTR claim copy via FEATURES_SERVER. Match UTR_CLAIMS_SHARED_SECRET in features-server and user-analytics.
UTR_CLAIMS_SHARED_SECRET=

# Direct upstreams (server-only; never use a NEXT_PUBLIC_ prefix).
# Per service: non-empty URL override -> API_KEY/pro-api -> public fallback.
# Empty values below keep existing routing. Keep API_KEY for a mix of direct and
# Pro services, or leave API_KEY empty to avoid Pro entirely. A direct request
# that fails does not retry through Pro. Public fallbacks may reject paid routes.
# Any configured direct URL enables development metadata pulls without API_KEY.
#
# Enter full base URLs, including any version or secret path described below.
# The app appends endpoint paths. Do not put auth query parameters in base URLs:
# the app adds them automatically from the separate keys. No backend key goes
# in a request body. Backend credentials are used only for server-side fetches.

# Core: e.g. https://api.llama.fi. API2_SECRET_KEY -> ?x-llama-pro-key=...
# V2 defaults to SERVER_URL + /v2 and uses the same key.
SERVER_URL=
V2_SERVER_URL=
API2_SECRET_KEY=

# Coins: e.g. https://coins.llama.fi.
# COINS_BACKEND_KEY -> ?x-coins-pro-key=...&requestType=pro
# This matches the proxy's Pro caller tier; its internal tier is not selected.
COINS_SERVER_URL=
COINS_BACKEND_KEY=

# Equities: include /v1 in the base URL.
# EQUITIES_SECRET_KEY -> ?x-llama-equity-secret=...
# If empty, the app uses API2_SECRET_KEY.
EQUITIES_SERVER_URL=
EQUITIES_SECRET_KEY=

# Liquidations: base URL without /all.
# LIQUIDATIONS_SECRET_KEY -> ?x-llama-secret=...
# Unlike the proxy, this app has no hardcoded fallback secret.
LIQUIDATIONS_SERVER_URL_V2=
LIQUIDATIONS_SECRET_KEY=

# Secret paths: paste the FULL deployed upstream URL, including its secret path.
# No separate key variable or auth query parameter is used for these services.
# Examples below use placeholders, not working credentials:
# RWA_PERPS_SERVER_URL=https://rwa-perps.example.com/<secret-path>
# YIELDS_V2_SERVER_URL=https://yields-v2.example.com/<secret-path>
# VAULT_RISK_SERVER_URL=https://vault-risk.example.com/<secret-path>
# Yields appends /v1 or /v2; vault risk appends /v1. Do not duplicate those suffixes.
RWA_PERPS_SERVER_URL=
YIELDS_V2_SERVER_URL=
VAULT_RISK_SERVER_URL=

# The proxy adds no backend key for the services below. That does not guarantee
# anonymous access: use the deployed upstream URL supplied by the service owner.
# Public bridges and FDV endpoints may return 402 without a working direct route.
# Datasets: public base https://defillama-datasets.llama.fi
DATASETS_SERVER_URL=
# Stablecoins: public base https://stablecoins.llama.fi
STABLECOINS_SERVER_URL=
# Bridges: public base https://bridges.llama.fi
BRIDGES_SERVER_URL=
# FDV / narrative categories: public base https://fdv-server.llama.fi
FDV_SERVER_URL=
# ETFs: public base https://etfs.llama.fi
ETF_SERVER_URL=
# Legacy yields: public base https://yields.llama.fi (versioned routes use V2 above).
YIELDS_SERVER_URL=
# RWA, digital asset treasuries (proxy section "dat"), and risks:
RWA_SERVER_URL=
TRADFI_API=
RISK_SERVER_URL=

# Pre-IPO, cards, and markets use the proxy's file cache. Keep API_KEY set for
# these services unless a compatible replacement endpoint is available.

REVALIDATE_SECRET=

CF_ZONE=
CF_PURGE_CACHE_AUTH=

# Shared by every app replica and the load balancer. The load balancer owns readiness and deduplication.
LB_CACHE_INVALIDATION_AUTH=
LB_CACHE_INVALIDATION_URL=https://defillama.com/_wipe-cache

# Shared key for features-server /internal/sql-results endpoints (server-only)
SQL_RESULTS_INTERNAL_KEY=

RCLONE_CONFIG_ARTIFACTS_ACCESS_KEY_ID=
RCLONE_CONFIG_ARTIFACTS_ENDPOINT=
RCLONE_CONFIG_ARTIFACTS_SECRET_ACCESS_KEY=

# =============================================================================
# INVESTOR DEPLOYMENTS (investors / staging / enterprise)
# Use SHARED vars above plus the block below. Omit the MAIN PRODUCTION section.
# =============================================================================

IR_SERVER_URL=

# --- pick one profile ---
NEXT_PUBLIC_INVESTORS_SITE=investors
# NEXT_PUBLIC_INVESTORS_PREVIEW=true

# enterprise profile instead:
# NEXT_PUBLIC_INVESTORS_SITE=enterprise
